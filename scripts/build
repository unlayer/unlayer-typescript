#!/usr/bin/env bash

set -exuo pipefail

cd "$(dirname "$0")/.."

./node_modules/.bin/tsdown

# Releases publish from dist/, so include package metadata and generated source
# beside the bundled CommonJS, ESM, and declaration output.
cp -rp src README.md dist
for file in LICENSE CHANGELOG.md; do
  if [ -e "${file}" ]; then cp "${file}" dist; fi
done
if [ -e "bin/cli" ]; then
  mkdir -p dist/bin
  cp -p "bin/cli" dist/bin/;
fi
if [ -e "bin/migration-config.json" ]; then
  mkdir -p dist/bin
  cp -p "bin/migration-config.json" dist/bin/;
fi
# this converts the export map paths for the dist directory
# and does a few other minor things
node scripts/utils/make-dist-package-json.cjs > dist/package.json

cp tsconfig.dist-src.json dist/src/tsconfig.json

# Verify the single allowlisted public entry point in CommonJS and ESM.
(cd dist && node -e 'const sdk = require("@unlayer/sdk"); const unlayer = new sdk.Unlayer({ apiKey: "test" }); if (typeof unlayer.templates.list !== "function" || "listTemplates" in unlayer.templates || "blocks" in unlayer || "NativeUnlayer" in sdk) process.exit(1)')
(cd dist && node -e 'const sdk = await import("@unlayer/sdk"); const unlayer = new sdk.Unlayer({ apiKey: "test" }); if (typeof unlayer.templates.list !== "function" || "listTemplates" in unlayer.templates || "blocks" in unlayer || "NativeUnlayer" in sdk) process.exit(1)' --input-type=module)
./node_modules/.bin/tsc --project tsconfig.consumer.json
