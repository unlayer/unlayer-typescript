#!/usr/bin/env bash

set -eu

cd "$(dirname "$0")/.."

node <<'NODE'
const packageJson = require('./package.json');
const [npmMajor = 0, npmMinor = 0, npmPatch = 0] = require('child_process')
  .execFileSync('npm', ['--version'], { encoding: 'utf8' })
  .trim()
  .split('.')
  .map(Number);

if (
  npmMajor < 11 ||
  (npmMajor === 11 && (npmMinor < 5 || (npmMinor === 5 && npmPatch < 1)))
) {
  throw new Error('npm 11.5.1 or newer is required for trusted publishing');
}

if (packageJson.publishConfig?.access !== 'public') {
  throw new Error('publishConfig.access must be public');
}

if (packageJson.repository?.url !== 'git+https://github.com/unlayer/unlayer-typescript.git') {
  throw new Error('repository URL must match the trusted publisher repository');
}
NODE

echo "The repository release configuration is valid."
