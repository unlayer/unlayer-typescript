#!/usr/bin/env bash

set -eu

cd "$(dirname "$0")/.."

if [ "${GITHUB_ACTIONS:-}" != "true" ]; then
  echo "Package releases must run in GitHub Actions." >&2
  exit 1
fi

if [ "${GITHUB_REF_TYPE:-}" != "tag" ]; then
  echo "Package releases must run from a Git tag." >&2
  exit 1
fi

VERSION="$(jq -r -e '.version' package.json)"
EXPECTED_TAG="v${VERSION}"

if [ "${GITHUB_REF_NAME:-}" != "$EXPECTED_TAG" ]; then
  echo "Release tag ${GITHUB_REF_NAME:-<missing>} does not match package version $VERSION." >&2
  exit 1
fi

RELEASE_SHA="${GITHUB_SHA:-HEAD}"
MAIN_REF="${RELEASE_MAIN_REF:-origin/main}"

if ! git merge-base --is-ancestor "$RELEASE_SHA" "$MAIN_REF"; then
  echo "Release commit $RELEASE_SHA is not an ancestor of $MAIN_REF." >&2
  exit 1
fi

echo "Release tag $EXPECTED_TAG matches package version $VERSION and belongs to $MAIN_REF."
